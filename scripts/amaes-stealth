#!/usr/bin/env bash
# ==============================================================================
# AMAES Toolkit & Database - Emergency Stealth Mode CLI
# ==============================================================================
# Toggles repositories and web services between Public and Private "Ghost" mode.
# When Stealth is ON:
#   - Repositories return 404 to the public.
#   - GitHub Pages return 404.
#   - Workflows and issue submissions are paused.
#   - Existing users continue using their offline browser cache on Moodle.
# When Stealth is OFF:
#   - Repositories return to Public.
#   - Web installer and GitHub Pages restored.
#   - Workflows and community contributions resume.
# ==============================================================================

set -eo pipefail

TOOLKIT_REPO="Acads-Tools/amaes-toolkit"
DATABASE_REPO="Acads-Tools/database"
GREASYFORK_ADMIN_URL="https://greasyfork.org/en/scripts/594744-amaes-toolkit/admin"
PAGES_URL="https://acads-tools.github.io/amaes-toolkit/"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

function check_gh() {
    if ! command -v gh >/dev/null 2>&1; then
        echo -e "${RED}[ERROR] GitHub CLI (gh) is not installed.${NC}"
        exit 1
    fi
    if ! gh auth status >/dev/null 2>&1; then
        echo -e "${RED}[ERROR] GitHub CLI is not authenticated. Run: gh auth login${NC}"
        exit 1
    fi
}

function get_visibility() {
    local repo="$1"
    gh repo view "$repo" --json visibility --jq '.visibility' 2>/dev/null || echo "UNKNOWN"
}

function show_status() {
    check_gh
    echo -e "\n${BOLD}${CYAN}=== AMAES TOOLKIT & DATABASE SECURITY STATUS ===${NC}\n"
    
    local tk_vis
    local db_vis
    tk_vis=$(get_visibility "$TOOLKIT_REPO")
    db_vis=$(get_visibility "$DATABASE_REPO")
    
    echo -n "  • Toolkit Repository ($TOOLKIT_REPO): "
    if [[ "$tk_vis" == "PRIVATE" ]]; then
        echo -e "${RED}${BOLD}PRIVATE (STEALTH / GHOST MODE)${NC}"
    elif [[ "$tk_vis" == "PUBLIC" ]]; then
        echo -e "${GREEN}${BOLD}PUBLIC (ACTIVE)${NC}"
    else
        echo -e "${YELLOW}$tk_vis${NC}"
    fi

    echo -n "  • Database Repository ($DATABASE_REPO): "
    if [[ "$db_vis" == "PRIVATE" ]]; then
        echo -e "${RED}${BOLD}PRIVATE (STEALTH / GHOST MODE)${NC}"
    elif [[ "$db_vis" == "PUBLIC" ]]; then
        echo -e "${GREEN}${BOLD}PUBLIC (ACTIVE)${NC}"
    else
        echo -e "${YELLOW}$db_vis${NC}"
    fi

    # Check HTTP public status
    echo -n "  • Webpage ($PAGES_URL): "
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" "$PAGES_URL" || echo "000")
    if [[ "$http_code" == "404" ]]; then
        echo -e "${RED}404 Not Found (Hidden from public)${NC}"
    elif [[ "$http_code" == "200" ]]; then
        echo -e "${GREEN}200 OK (Publicly accessible)${NC}"
    else
        echo -e "${YELLOW}HTTP $http_code${NC}"
    fi

    echo -e "\n  • Greasy Fork Admin: ${BLUE}${GREASYFORK_ADMIN_URL}${NC}\n"
}

function enable_stealth() {
    check_gh
    echo -e "\n${BOLD}${YELLOW}[!] ACTIVATING EMERGENCY STEALTH MODE...${NC}"
    echo -e "This will set both repositories to PRIVATE so external observers see only 404.\n"

    echo -e "${CYAN}--> Setting $TOOLKIT_REPO to PRIVATE...${NC}"
    gh repo edit "$TOOLKIT_REPO" --visibility private --yes

    echo -e "${CYAN}--> Setting $DATABASE_REPO to PRIVATE...${NC}"
    gh repo edit "$DATABASE_REPO" --visibility private --yes

    echo -e "${CYAN}--> Pausing community auto-merge workflow...${NC}"
    gh workflow disable auto-merge-contributions.yml --repo "$DATABASE_REPO" 2>/dev/null || true

    echo -e "\n${GREEN}${BOLD}✓ STEALTH MODE ACTIVATED!${NC}"
    echo -e "--------------------------------------------------"
    echo -e "1. ${BOLD}GitHub Visibility:${NC} Repositories and GitHub Pages now return ${RED}404 Not Found${NC} to outside visitors."
    echo -e "2. ${BOLD}Deterrent Effect:${NC} Attackers or curious users will perceive the project as deleted or abandoned."
    echo -e "3. ${BOLD}Active User Impact:${NC} Existing students using the toolkit on Moodle will continue using their ${GREEN}local browser cache${NC} without disruption."
    echo -e "4. ${BOLD}Greasy Fork (Optional):${NC} If you also want Greasy Fork to appear deleted, visit:"
    echo -e "   👉 ${BLUE}${GREASYFORK_ADMIN_URL}${NC}"
    echo -e "   and click '${YELLOW}Delete this script${NC}' or turn off syncing."
    echo -e "--------------------------------------------------\n"
}

function disable_stealth() {
    check_gh
    echo -e "\n${BOLD}${CYAN}[*] RESTORING PUBLIC VISIBILITY & SERVICES...${NC}\n"

    echo -e "${CYAN}--> Setting $TOOLKIT_REPO to PUBLIC...${NC}"
    gh repo edit "$TOOLKIT_REPO" --visibility public --yes

    echo -e "${CYAN}--> Setting $DATABASE_REPO to PUBLIC...${NC}"
    gh repo edit "$DATABASE_REPO" --visibility public --yes

    echo -e "${CYAN}--> Re-enabling community auto-merge workflow...${NC}"
    gh workflow enable auto-merge-contributions.yml --repo "$DATABASE_REPO" 2>/dev/null || true

    echo -e "\n${GREEN}${BOLD}✓ ALL SERVICES RESTORED TO PUBLIC!${NC}"
    echo -e "--------------------------------------------------"
    echo -e "1. ${BOLD}Repositories:${NC} Both repositories are public again."
    echo -e "2. ${BOLD}Web Installer:${NC} GitHub Pages will come back online shortly."
    echo -e "3. ${BOLD}Community Sync:${NC} Question sharing and auto-merge engine are active."
    echo -e "--------------------------------------------------\n"
}

case "${1:-status}" in
    on|stealth|hide|dark|kill)
        enable_stealth
        ;;
    off|public|restore|live)
        disable_stealth
        ;;
    status)
        show_status
        ;;
    help|-h|--help)
        echo -e "${BOLD}Usage:${NC} amaes-stealth {on|off|status}"
        echo -e "  • ${BOLD}on${NC}     : Activate stealth mode (set repos to PRIVATE, pause workflows, hide from public)"
        echo -e "  • ${BOLD}off${NC}    : Deactivate stealth mode (set repos to PUBLIC, restore all services)"
        echo -e "  • ${BOLD}status${NC} : Check current visibility and endpoints status"
        exit 0
        ;;
    *)
        echo -e "${BOLD}Usage:${NC} amaes-stealth {on|off|status}"
        echo -e "  • ${BOLD}on${NC}     : Activate stealth mode (set repos to PRIVATE, pause workflows, hide from public)"
        echo -e "  • ${BOLD}off${NC}    : Deactivate stealth mode (set repos to PUBLIC, restore all services)"
        echo -e "  • ${BOLD}status${NC} : Check current visibility and endpoints status"
        exit 1
        ;;
esac
